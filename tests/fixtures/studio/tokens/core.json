{
  "color": {
    "$type": "color",
    "blue": {
      "500": {"$value": {"colorSpace": "srgb", "components": [0.23137, 0.5098, 0.96471], "hex": "#3b82f6"}},
      "700": {"$value": "#1d4ed8"}
    },
    "gray": {
      "50": {"$value": "#f9fafb"},
      "200": {"$value": "#e5e7eb"},
      "600": {"$value": "#4b5563"},
      "800": {"$value": "#1f2937"},
      "900": {"$value": "#111827"}
    },
    "white": {"$value": "#ffffff"},
    "red": {"500": {"$value": "#ef4444"}},
    "green": {"500": {"$value": "#22c55e"}},
    "shadow": {"$value": {"colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1}}
  },
  "space": {
    "$type": "dimension",
    "1": {"$value": {"value": 4, "unit": "px"}},
    "2": {"$value": {"value": 8, "unit": "px"}},
    "3": {"$value": {"value": 0.75, "unit": "rem"}},
    "4": {"$value": {"value": 16, "unit": "px"}},
    "6": {"$value": {"value": 24, "unit": "px"}},
    "8": {"$value": {"value": 32, "unit": "px"}}
  },
  "radius": {
    "$type": "dimension",
    "sm": {"$value": {"value": 4, "unit": "px"}},
    "md": {"$value": {"value": 8, "unit": "px"}},
    "full": {"$value": {"value": 9999, "unit": "px"}}
  },
  "font": {
    "size": {
      "$type": "dimension",
      "sm": {"$value": {"value": 0.875, "unit": "rem"}},
      "md": {"$value": {"value": 1, "unit": "rem"}},
      "lg": {"$value": {"value": 20, "unit": "px"}},
      "xl": {"$value": {"value": 24, "unit": "px"}}
    },
    "family": {
      "$type": "fontFamily",
      "sans": {"$value": ["Arial", "Helvetica", "sans-serif"]},
      "mono": {"$value": ["Courier New", "monospace"]}
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {"$value": 400},
      "bold": {"$value": "bold"}
    },
    "lineHeight": {
      "$type": "number",
      "normal": {"$value": 1.5},
      "tight": {"$value": 1.25}
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "thin": {"$value": {"value": 1, "unit": "px"}},
      "thick": {"$value": {"value": 2, "unit": "px"}}
    }
  },
  "shadow": {
    "sm": {"$type": "shadow", "$value": {"color": "{color.shadow}", "offsetX": {"value": 0, "unit": "px"},
           "offsetY": {"value": 1, "unit": "px"}, "blur": {"value": 2, "unit": "px"}, "spread": {"value": 0, "unit": "px"}}}
  }
}
