<?xml version="1.0" encoding="UTF-8"?>
<!-- The openajar desktop's window manager (openbox). Written to the screen's folder each time the screen
     starts (openajar.environments.vmbrowser_ctl); the theme is openbox/themerc beside it. -->
<openbox_config xmlns="http://openbox.org/3.4/rc" xmlns:xi="http://www.w3.org/2001/XInclude">
  <resistance><strength>10</strength><screen_edge_strength>20</screen_edge_strength></resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <placement><policy>Smart</policy><center>yes</center><monitor>Primary</monitor></placement>
  <theme>
    <name>openajar</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow"><name>Inter Variable</name><size>10</size><weight>bold</weight><slant>normal</slant></font>
    <font place="InactiveWindow"><name>Inter Variable</name><size>10</size><weight>bold</weight><slant>normal</slant></font>
    <font place="MenuHeader"><name>Inter Variable</name><size>9</size><weight>bold</weight><slant>normal</slant></font>
    <font place="MenuItem"><name>Inter Variable</name><size>10</size><weight>normal</weight><slant>normal</slant></font>
    <font place="ActiveOnScreenDisplay"><name>Inter Variable</name><size>10</size><weight>bold</weight><slant>normal</slant></font>
    <font place="InactiveOnScreenDisplay"><name>Inter Variable</name><size>10</size><weight>bold</weight><slant>normal</slant></font>
  </theme>
  <desktops><number>1</number><firstdesk>1</firstdesk><names><name>openajar</name></names><popupTime>0</popupTime></desktops>
  <resize><drawContents>yes</drawContents><popupShow>Never</popupShow></resize>
  <margins><top>0</top><bottom>0</bottom><left>0</left><right>0</right></margins>
  <dock><noStrut>no</noStrut><stacking>Above</stacking></dock>
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
    <keybind key="A-F4"><action name="If"><query><class>*amoufox*</class></query>
      <then><action name="Iconify"/></then><else><action name="Close"/></else></action></keybind>
    <keybind key="A-Tab"><action name="NextWindow"><finalactions><action name="Focus"/><action name="Raise"/><action name="Unshade"/></finalactions></action></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow"><finalactions><action name="Focus"/><action name="Raise"/><action name="Unshade"/></finalactions></action></keybind>
    <keybind key="C-A-t"><action name="Execute"><command>lxterminal --no-remote --working-directory=/work -e "env -u XDG_CONFIG_HOME bash -l"</command></action></keybind>
    <keybind key="W-Up"><action name="Maximize"/></keybind>
    <keybind key="W-Down"><action name="Unmaximize"/></keybind>
  </keyboard>
  <mouse>
    <dragThreshold>3</dragThreshold>
    <doubleClickTime>400</doubleClickTime>
    <context name="Frame">
      <mousebind button="A-Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="A-Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="A-Right" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
    </context>
    <context name="Titlebar Top Right Bottom Left TLCorner TRCorner BRCorner BLCorner">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/><action name="Unshade"/></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
    </context>
    <context name="Top"><mousebind button="Left" action="Drag"><action name="Resize"><edge>top</edge></action></mousebind></context>
    <context name="Left"><mousebind button="Left" action="Drag"><action name="Resize"><edge>left</edge></action></mousebind></context>
    <context name="Right"><mousebind button="Left" action="Drag"><action name="Resize"><edge>right</edge></action></mousebind></context>
    <context name="Bottom"><mousebind button="Left" action="Drag"><action name="Resize"><edge>bottom</edge></action></mousebind></context>
    <context name="TRCorner BRCorner TLCorner BLCorner"><mousebind button="Left" action="Drag"><action name="Resize"/></mousebind></context>
    <context name="Client">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Middle" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
    </context>
    <context name="Icon">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
    </context>
    <context name="AllDesktops Shade"/>
    <context name="Iconify">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Left" action="Click"><action name="Iconify"/></mousebind>
    </context>
    <context name="Maximize">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Left" action="Click"><action name="ToggleMaximize"/></mousebind>
    </context>
    <!-- The agent's browser is never closed from its frame: its close button minimizes it (the dock's
         Browser brings it back), so the agent's browser, its pages and its sign-ins stay. -->
    <context name="Close">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Left" action="Click"><action name="If"><query><class>*amoufox*</class></query>
        <then><action name="Iconify"/></then><else><action name="Close"/></else></action></mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind>
    </context>
  </mouse>
  <menu><file>menu.xml</file><hideDelay>200</hideDelay><middle>no</middle><submenuShowDelay>100</submenuShowDelay>
    <applicationIcons>no</applicationIcons><manageDesktops>no</manageDesktops></menu>
  <applications>
    <!-- any other app (one the agent starts): centred, unless it asks for its own place -->
    <application class="*" type="normal">
      <position force="no"><x>center</x><y>center</y></position>
    </application>
    <!-- the agent's browser: placed where the page is told it is, with the wallpaper around it. It starts in
         the background, so a new browser window takes no focus by itself: an app opened before it keeps the
         keyboard, and desk.py (FocusGuard) gives the browser focus when nothing else has it -->
    <application class="*amoufox*" type="normal">
      <decor>yes</decor><focus>no</focus><maximized>AGENTOS_BROWSER_MAXIMIZED</maximized>
      <position force="yes"><x>AGENTOS_BROWSER_X</x><y>AGENTOS_BROWSER_Y</y></position>
    </application>
    <!-- a person's own Terminal and Files open over the browser, offset so both show -->
    <application class="Lxterminal" type="normal">
      <position force="no"><x>180</x><y>150</y></position>
    </application>
    <application class="Pcmanfm" type="normal">
      <position force="no"><x>560</x><y>230</y></position>
    </application>
    <!-- the agent's terminal ("<agent> · commands"): bottom left, over the browser's corner -->
    <application title="* · commands">
      <position force="no"><x>104</x><y>AGENTOS_AGENT_TERM_Y</y></position>
    </application>
  </applications>
</openbox_config>
