# openajar: the desktop's window frames for openbox (original work, the Dawn design). Light title bars with a
# soft top-down fade, a 1 px edge, square corners and no shadow; Inter titles; small grey buttons.
border.width: 1
padding.width: 11
padding.height: 9
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: 0
menu.overlap.y: 0
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 4

