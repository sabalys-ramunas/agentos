<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The openajar controller as a LaunchAgent. setup.sh fills in __OPENAJAR_BIN__, __OPENAJAR_HOME__
     and __LOG_DIR__ (render_plist.py) and loads it into the logged-in user's session. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.agentos.controller</string>
  <key>ProgramArguments</key>
  <array>
    <string>__OPENAJAR_BIN__</string>
    <string>controller</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OPENAJAR_HOME</key>
    <string>__OPENAJAR_HOME__</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__OPENAJAR_HOME__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/controller.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/controller.log</string>
</dict>
</plist>
